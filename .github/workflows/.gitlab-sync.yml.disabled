# .github/workflows/gitlab-sync.yml
name: Sync from GitLab

on:
  schedule:
    - cron: '0 2 * * 1'  # every Monday at 2:00 AM UTC
  workflow_dispatch:  # allows manual triggering of the workflow

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Install Git
        run: sudo apt-get install git

      # - name: Clone GitLab Repo  (WARNING: OVERWRITE GITHUB REPO)
      #   run: |
      #     git clone --mirror https://oauth2:${{ secrets.GITLAB_READTOKEN }}@gitlab.com/warp-scores/warp-scores.git
      #     cd warp-scores.git
      #     git remote add github https://${{ secrets.UPDATE_TOKEN }}@github.com/dennisgranasen/cyanidebowl.git
      #     git push --mirror github

      - name: Checkout GitHub repo
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.UPDATE_TOKEN }}
          fetch-depth: 0

      - name: Add GitLab remote and fetch
        run: |
          git remote add gitlab https://oauth2:${{ secrets.GITLAB_READTOKEN }}@gitlab.com/warp-scores/warp-scores.git
          git fetch gitlab

      - name: Merge GitLab/main into GitHub/main
        run: |
          git checkout main
          git merge gitlab/main --allow-unrelated-histories --no-edit || true
          git push origin main
