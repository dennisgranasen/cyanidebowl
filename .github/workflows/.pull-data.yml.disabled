name: Pull data from Cyanide and update MongoDB

on:
  workflow_dispatch:  # allows manual triggering of the workflow
  schedule:
    - cron: '*/2 * * * *'    # every 2 days
jobs:
  fetch_data:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Build with Maven
        run: mvn clean package -DskipTests -DskipDocker -P fetcher -pl api,cyanide-api,backend -am

      - name: Fetch Competitions
        env:
          SPRING_MONGODB_URI: ${{ secrets.MONGODB_URI }}
          CYANIDE_API_KEY: ${{ secrets.CYANIDE_API_KEY }}
        run: java -jar ./backend/target/backend.jar

      # Optionally, upload logs or artifacts if needed