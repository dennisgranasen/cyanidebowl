# Copy to $HOME/blaskscore/.env on the Oracle VM and fill in real values.
# Never commit the populated file or put it in GitHub Actions.

PYBB3_REF=main
SPRING_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
BACKEND_IMAGE=cyanidebowl-backend:arm64
PYBB3_IMAGE=cyanidebowl-pybb3-service:arm64
PYBB3_DATA_GID=20000

CYANIDE_API_KEY=
PYBB3_CREDENTIAL_ENCRYPTION_KEY=
PYBB3_INTERNAL_API_KEY=

SPRING_PROFILES_ACTIVE=server
SERVER_PORT=8080

AUTH0_DOMAIN=<tenant>.eu.auth0.com
AUTH0_URI=https://<tenant>.eu.auth0.com/
AUTH0_AUDIENCE=https://api.example.com
AUTH0_CLIENT_ID=<public-client-id>

FRONTEND_URI=https://<firebase-custom-domain>
REACT_APP_BACKEND_URI=https://api.example.com/api
NODE_ENV=production

AI_API_KEY_GEMINI=
AI_API_KEY_GROQ=
AI_API_KEY_OPENROUTER=
AI_API_KEY_OPENAI=
AI_API_KEY_CLOUDFLARE=
AI_API_KEY_AION=
AI_API_KEY_MISTRAL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_TIMEOUT=3m
CLOUDFLARE_IMAGE_STEPS=4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT=3m

# Create a dedicated Cloudflare Tunnel for the API, separate from any frontend tunnel.
CLOUDFLARE_API_TUNNEL_TOKEN=

COMMUNITY_MEDIA_PROVIDER=cloudflare
COMMUNITY_MEDIA_QUALITY=low
COMMUNITY_MEDIA_POLL_MS=30000
COMMUNITY_MEDIA_MAX_ATTEMPTS=4
COMMUNITY_MEDIA_RETRY_BASE_DELAY=30s
COMMUNITY_MEDIA_RUNNING_TIMEOUT=10m
COMMUNITY_MEDIA_QUOTA_EXHAUSTED_COOLDOWN=12h
FAN_RATE_LIMIT_COOLDOWN=10m

# Storage is mounted from $HOME/blaskscore/data on Oracle.
REPLAY_SWEEPER_STORAGE_DIRECTORY=./data/replays