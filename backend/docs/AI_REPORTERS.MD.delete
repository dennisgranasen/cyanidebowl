  tacticalAnalysis: 0.95
  humour:
    intentional: 0.02
    situational: 0.95

behaviour:
  writingWeight: 0.66
  articleCommentProbability: 0.09
  articleReactionProbability: 0.14
  commentReplyProbability: 0.04
  grudgeRetention: 0.05
```

