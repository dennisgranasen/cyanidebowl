version: '3.1'

services:
  warpscores-db:
    container_name: warpscores-db
    hostname: warpscores-db
    image: 'mongo:latest'
    environment:
      - 'MONGO_INITDB_DATABASE=warpscores'
      - 'MONGO_INITDB_ROOT_PASSWORD=[PASSWORD]'
      - 'MONGO_INITDB_ROOT_USERNAME=root'
    restart: unless-stopped
    volumes:
      - ./data:/data/db
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - warpscores-backend

  warpscores-backend:
    container_name: warpscores-backend
    hostname: warpscores-backend
    image: 'warpscores/warpscores-backend:1.0.0-SNAPSHOT'
    depends_on:
      - warpscores-db
    environment:
      SPRING_PROFILES_ACTIVE: prod
    restart: unless-stopped
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - warpscores-backend
      - warpscores-frontend

  warpscores-frontend:
    container_name: warpscores-frontend
    hostname: warpscores-frontend
    image: 'warpscores/warpscores-frontend:1.0.0-SNAPSHOT'
    ports:
      - '8022:80'
    depends_on:
      - warpscores-backend
    restart: unless-stopped
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - warpscores-frontend

  warpscores-discord-bot:
    container_name: warpscores-discord-bot
    hostname: warpscores-discord-bot
    image: 'warpscores/warpscores-discord-bot:1.0.0-SNAPSHOT'
    depends_on:
      - warpscores-backend
    restart: unless-stopped
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - warpscores-frontend

networks:
  warpscores-backend:
    external: false
  warpscores-frontend:
    driver: bridge
