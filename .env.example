# ========================================================
# 1. Infrastructure & Keys for Build Steps
# ========================================================
CLOUDFLARE_TUNNEL_TOKEN=eyJhSWoiOiI...
GITHUB_TOKEN=ghp_ditt_github_token
PYBB3_REF=main

# ========================================================
# 2. Database (MongoDB Atlas)
# ========================================================
SPRING_MONGODB_URI=mongodb+srv://...

# ========================================================
# 3. Security & Internal Keys
# ========================================================
CYANIDE_API_KEY=...
PYBB3_CREDENTIAL_ENCRYPTION_KEY=...
PYBB3_INTERNAL_API_KEY=...

# ========================================================
# 4. Spring Boot Configuration
# ========================================================
SPRING_PROFILES_ACTIVE=dev
#SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ========================================================
# 5. Authentication (Auth0 / Keycloak / etc.)
# ========================================================
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_URI=https://${AUTH0_DOMAIN}/
AUTH0_AUDIENCE=https://api.your-domain.com
AUTH0_CLIENT_ID=your_auth0_client_id_here

# ========================================================
# 6. Domains & Routing (For CORS and Frontend Build)
# ========================================================
# Used by Spring Boot for CORS (which origins are allowed to call the API)
FRONTEND_URI=https://bb3.your-domain.com

# Used by React during the Docker build to know where to send API requests
#REACT_APP_BACKEND_URI=https://bb3.your-domain.com/api
REACT_APP_BACKEND_URI=http://localhost:8080
# Used by React during the Docker build to know where to send API requests