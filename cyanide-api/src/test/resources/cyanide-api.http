# ##############################################################################
# Misc #########################################################################

### Get info about api
GET https://web.cyanide-studio.com/ws/?bb=3&key={{apiKey}}

### Get status
GET https://web.cyanide-studio.com/ws/cya/status/?key={{apiKey}}

# ##############################################################################
# Lookup #######################################################################

### Lookup league
GET https://web.cyanide-studio.com/ws/bb3/lookup/?league=Official&exact=0&key={{apiKey}}

### Lookup coach
GET https://web.cyanide-studio.com/ws/bb3/lookup/?coach=naytsyrhc&key={{apiKey}}

### Lookup coach
GET https://web.cyanide-studio.com/ws/bb3/tournaments/?platform=pc&key={{apiKey}}

# ##############################################################################
# League #######################################################################

### Get leagues
GET https://web.cyanide-studio.com/ws/bb3/leagues/?league=Official&limit=100&key={{apiKey}}

### Get leagues
GET https://web.cyanide-studio.com/ws/bb3/competitions/?league_id=30000000-0000-0000-0000-000000000025&limit=100&key={{apiKey}}

### Get leagues
GET https://web.cyanide-studio.com/ws/bb3/competitions/?competition_id=00000001-0000-0000-0000-000000000002&limit=100&key={{apiKey}}



### Get league
GET https://web.cyanide-studio.com/ws/bb3/league/?id=94dd6ae4-83fa-11ee-b910-02000090a64f&key={{apiKey}}

### Get competitions
GET https://web.cyanide-studio.com/ws/bb3/competitions/?league_id=c9c30e36-5ca5-11ee-af36-020000a4d571&key={{apiKey}}

# ##############################################################################
# Competition ##################################################################

### Get coaches
GET https://web.cyanide-studio.com/ws/bb3/coaches/?league_uuid=94dd6ae4-83fa-11ee-b910-02000090a64f&limit=100&key={{apiKey}}

### Get teams
GET https://web.cyanide-studio.com/ws/bb3/teams/?league_id=94dd6ae4-83fa-11ee-b910-02000090a64f&competition_id=e8848221-a04e-11ee-a745-02000090a64f&key={{apiKey}}&order=finished

### Get contests * by league_id for status Played
GET https://web.cyanide-studio.com/ws/bb3/contests/?status=Played&league_id=94dd6ae4-83fa-11ee-b910-02000090a64f&key={{apiKey}}

### Get contests * by league_id for status Validated
GET https://web.cyanide-studio.com/ws/bb3/contests/?status=*&league_id=&limit=0,+100&key={{apiKey}}

### Get contests * by competition_id
GET https://web.cyanide-studio.com/ws/bb3/contests/?status=*&competition_id=fdcd5dde-e529-11ee-bbf2-0200000e1421&limit=0,+1000&order=started,desc&key={{apiKey}}

### Get matches
GET https://web.cyanide-studio.com/ws/bb3/matches/?competition_id=fdcd5dde-e529-11ee-bbf2-0200000e1421&order=started,desc&limit=100,+100&key={{apiKey}}&bb=3

, competition_name=null, competition_id=null, start=Sat Jul 06 13:04:56 CEST 2024,

### Get matches (ordered)
GET https://web.cyanide-studio.com/ws/bb3/matches/?league_id=94dd6ae4-83fa-11ee-b910-02000090a64f&startDate=2023-12-01&key={{apiKey}}&order=finished

### Get match by id
GET https://web.cyanide-studio.com/ws/bb3/match/?uuid=172b2f97-b4a2-11ee-a745-02000090a64f&key={{apiKey}}

