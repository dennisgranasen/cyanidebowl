{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start pybb3",
      "type": "process",
      "command": "docker",
      "args": ["compose", "-f", "compose.yaml", "-f", "compose.local.yaml", "up", "-d", "--build", "--wait", "pybb3-service"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Prepare local services",
      "dependsOn": ["Start pybb3", "Build backend"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
        "label": "Build backend",
        "type": "shell",
        "command": "mvn",
        "args": [
            "-Pdev",
            "-pl",
            "backend",
            "-am",
            "package",
            "-DskipTests",
            "-DskipDocker=true"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [
            "$msCompile"
        ],
        "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "clear": true
        }
    }
  ]
}
