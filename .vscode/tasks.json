{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build backend",
        "type": "shell",
        "command": "mvn",
        "args": [
            "-Pdev",
            "-pl",
            "backend",
            "-am",
            "package",
            "-DskipTests",
            "-DskipDocker=true"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [
            "$msCompile"
        ],
        "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "clear": true
        }
    }
  ]
}